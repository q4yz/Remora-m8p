component extruder "Extruder thermal safety, watchdog, hardware PWM cutoff and cold-extrusion guard";

description """
Cold-extrusion guard (Klipper's min_extrude_temp): while the extruder
joint is commanded to move (\\fBvel-cmd\\fR, extrude or retract) and
\\fBcurrent-temp\\fR is below \\fBmin-extrude-temp\\fR, \\fBcold-extrude\\fR
is TRUE once the move lasted \\fBmin-extrude-time\\fR (a homing jump of
the position is a one-period velocity spike, not a move); nothing while
\\fBhoming\\fR (\\fBjoint.N.homing\\fR) is TRUE. Net it to \\fBhalui.abort\\fR: the program or MDI move stops,
as Klipper refuses an "extrude below minimum temp". One error message
per stop. The motor enable is not gated, a disabled stepper would leave
LinuxCNC's commanded position running away from the real one.

Flow (M221): with \\fBpos-cmd-in\\fR / \\fBpos-fb-out\\fR between the joint
and \\fBpos-cmd-out\\fR / \\fBpos-fb-in\\fR to the stepgen, the extruder's
moves are scaled by \\fBflow-percent\\fR (10 ... 500, 0 = 100). A new value
is rebased on the current position, so it never jumps; the feedback is
scaled back, so LinuxCNC's following error stays as before.

Pressure advance (Klipper's): while extruding during an X / Y move, the
stepgen is moved \\fBpressure-advance\\fR × the extruder's speed ahead (mm
per mm/s), smoothed over \\fBpa-smooth-time\\fR; the feedback removes it
again. Like Klipper, not for extruder-only moves (retract, unretract,
loading): the target is 0 unless \\fBvel-x\\fR / \\fBvel-y\\fR (the X / Y
joints' \\fBvel-cmd\\fR) say the head moves. The offset changes no faster
than leaves the stepgen within \\fBmax-velocity\\fR (mm/s, the extruder
joint's MAX_VELOCITY; 0 = no limit): a CAN node's step generator has a
hard step-rate limit, and LinuxCNC never sees the offset to plan for it.
Ignored while homing and for jumps (> 500 mm/s).

.nf
loadrt extruder names=extruder-heater_extruder
addf extruder-heater_extruder servo-thread
setp extruder-heater_extruder.min-extrude-temp 170
net extruder-PV => extruder-heater_extruder.current-temp
net heater_extruder-vel-cmd joint.3.vel-cmd => extruder-heater_extruder.vel-cmd
net heater_extruder-homing joint.3.homing => extruder-heater_extruder.homing
net heater_extruder-cold-extrude extruder-heater_extruder.cold-extrude => halui.abort
net j3pos-cmd joint.3.motor-pos-cmd => extruder-heater_extruder.pos-cmd-in
net j3pos-cmd-flow extruder-heater_extruder.pos-cmd-out => remora.joint.3.pos-cmd
net j3pos-fb remora.joint.3.pos-fb => extruder-heater_extruder.pos-fb-in
net j3pos-fb-flow extruder-heater_extruder.pos-fb-out => joint.3.motor-pos-fb
net heater_extruder-flow webgui.flow => extruder-heater_extruder.flow-percent
net heater_extruder-vel-x joint.0.vel-cmd => extruder-heater_extruder.vel-x
net heater_extruder-vel-y joint.1.vel-cmd => extruder-heater_extruder.vel-y
setp extruder-heater_extruder.max-velocity [JOINT_3]MAX_VELOCITY
.fi
""";

// --- Inputs ---
pin in float current_temp "Live temperature from Remora";
pin in float requested_temp "Target temperature from GUI";
pin in float pid_pwm_in "PWM output coming from the PID component";
pin in bit machine_enabled "True when machine is ON (not E-stopped)";
pin in float vel_cmd "Extruder joint's commanded velocity (joint.N.vel-cmd)";
pin in bit cold_extrude_enable = 1 "FALSE switches the cold-extrusion guard off";
pin in bit homing "The extruder joint is homing (joint.N.homing): no guard";
pin in float pos_cmd_in "Flow: the joint's motor-pos-cmd";
pin in float pos_fb_in "Flow: the stepgen's position feedback";
pin in float flow_percent = 100.0 "Flow: extrusion in percent, 10 ... 500 (0 = 100)";
pin in float pressure_advance = 0.0 "Pressure advance: mm of extra extruder position per mm/s (0 = off)";
pin in float vel_x "Pressure advance: the X joint's vel-cmd (PA only while X / Y move)";
pin in float vel_y "Pressure advance: the Y joint's vel-cmd";

// --- User Parameters ---
param rw float min_valid_temp = 5.0 "Failsafe: Tripped if sensor disconnects";
param rw float max_valid_temp = 290.0 "Failsafe: Tripped on thermal runaway";
param rw float min_extrude_temp = 170.0 "Threshold for cold extrusion block";
param rw float heatsink_fan_temp = 50.0 "Threshold to turn on the cold-end fan";
param rw float watchdog_time = 20.0 "Seconds allowed without temperature rising";
param rw float min_extrude_vel = 0.000001 "A |vel-cmd| above this is an extruder move (units/s)";
param rw float min_extrude_time = 0.05 "Seconds an extruder move must last before cold_extrude (ignores a homing spike)";
param rw float pa_smooth_time = 0.040 "Pressure advance smoothing time (s), Klipper's pressure_advance_smooth_time";
param rw float max_velocity = 0.0 "Pressure advance: the stepgen's speed limit (mm/s, 0 = none); the offset never pushes past it";
param rw float min_xy_vel = 0.1 "Pressure advance: X / Y faster than this (mm/s) is a move that extrudes";

// --- Outputs ---
pin out float safe_target_temp "Sent to PID command";
pin out float safe_pwm_out "Sent to Remora hardware heater pin";
pin out bit heatsink_fan "True if temp > heatsink_fan_temp";
pin out bit temp_ready "True if temp >= min_extrude_temp (sent to extruder)";
pin out bit cold_extrude "True while the extruder is commanded to move below min_extrude_temp: net to halui.abort";
pin out float pos_cmd_out "Flow: the scaled position for the stepgen";
pin out float pos_fb_out "Flow: the feedback scaled back for the joint's motor-pos-fb";
pin out float pa_offset "Pressure advance: the extra position applied now (mm)";

// Safety Faults (Wire these to an OR2 gate, then to E-stop)
pin out bit fault_range "True if sensor reads < 5 or > 290";
pin out bit fault_watchdog "True if heating command is sent but temp doesn't rise";

// Internal variables for the timer
variable double timer = 0.0;
variable double saved_temp = 0.0;
variable int cold_reported = 0;
variable double moving_time = 0.0;
variable double flow_base_in = 0.0;
variable double flow_base_out = 0.0;
variable double flow_factor = 1.0;
variable int flow_started = 0;
variable double pa_last_in = 0.0;
variable double pa_value = 0.0;

license "GPL";

function _ fp;
;;

#include <rtapi_math.h>

FUNCTION(_) {
    // 1. Hardware Failsafe / E-Stop handling
    // If E-stop is active, instantly sever the PWM line and force target to 0
    if (!machine_enabled) {
        safe_target_temp = 0.0;
        safe_pwm_out = 0.0;
        timer = 0.0; // Reset watchdog
    } else {
        safe_target_temp = requested_temp;
        safe_pwm_out = pid_pwm_in;
    }

    // 2. Sensor Range & Thermal Runaway Check
    if (current_temp < min_valid_temp || current_temp > max_valid_temp) {
        fault_range = 1;
        safe_pwm_out = 0.0; // Cut hardware power instantly
    } else {
        fault_range = 0;
    }

    // 3. Heatsink Fan Control
    heatsink_fan = (current_temp > heatsink_fan_temp);

    // 4. Extruder Ready Signal
    temp_ready = (current_temp >= min_extrude_temp);

    // 4b. Cold-extrusion guard: the extruder is commanded to move while cold,
    // for min_extrude_time without a break (homing sets the position in
    // place: a one-period vel_cmd spike, not a move)
    if (homing || fabs(vel_cmd) <= min_extrude_vel) {
        moving_time = 0.0;
    } else {
        moving_time += fperiod;
    }
    if (cold_extrude_enable && moving_time >= min_extrude_time && !temp_ready) {
        cold_extrude = 1;
        if (!cold_reported) {
            rtapi_print_msg(RTAPI_MSG_ERR,
                "extruder: extrude below minimum temp (%.1f < %.1f C): stopped\n",
                (double)current_temp, (double)min_extrude_temp);
            cold_reported = 1;
        }
    } else {
        cold_extrude = 0;
        if (fabs(vel_cmd) <= min_extrude_vel) {
            cold_reported = 0; // armed again once the extruder stands still
        }
    }

    // 4c. Flow: scale the extruder's moves, rebased on every change of the
    // factor so a new value never jumps the position
    {
        double k = flow_percent;
        if (k <= 0.0) k = 100.0;          // unset
        if (k < 10.0) k = 10.0;
        if (k > 500.0) k = 500.0;
        k = k / 100.0;
        if (!flow_started) {
            flow_base_in = pos_cmd_in;
            flow_base_out = pos_cmd_in;
            flow_factor = k;
            flow_started = 1;
        }
        if (k != flow_factor) {
            flow_base_out += (pos_cmd_in - flow_base_in) * flow_factor;
            flow_base_in = pos_cmd_in;
            flow_factor = k;
        }
        pos_cmd_out = flow_base_out + (pos_cmd_in - flow_base_in) * flow_factor;

        // 4d. Pressure advance: ahead by K x the extruder's (scaled) speed
        double v = fperiod > 0.0 ? (pos_cmd_in - pa_last_in) / fperiod * flow_factor : 0.0;
        double target = 0.0;
        int xy_moving = fabs(vel_x) + fabs(vel_y) > min_xy_vel;
        pa_last_in = pos_cmd_in;
        if (pressure_advance > 0.0 && !homing && xy_moving && v > 0.0 && v < 500.0) {
            target = pressure_advance * v;
        }
        double alpha = pa_smooth_time > 0.0 ? fperiod / pa_smooth_time : 1.0;
        if (alpha > 1.0) alpha = 1.0;
        double step = (target - pa_value) * alpha;
        // the offset's own speed: what the stepgen has left above the move's
        if (max_velocity > 0.0) {
            double room = (max_velocity - fabs(v)) * fperiod;
            if (room < 0.0) room = 0.0;
            if (step > room) step = room;
            if (step < -room) step = -room;
        }
        pa_value += step;
        if (pressure_advance <= 0.0 && fabs(pa_value) < 1e-9) pa_value = 0.0;
        pa_offset = pa_value;
        pos_cmd_out += pa_value;
        pos_fb_out = flow_base_in + (pos_fb_in - pa_value - flow_base_out) / flow_factor;
    }

    // 5. Heating Watchdog (Dead-Heater Detection)
    // If we want it hot, but it's cold, start counting
    if (machine_enabled && (safe_target_temp > current_temp + 3.0)) {
        timer += fperiod; // fperiod is the exact time since the last thread cycle (e.g. 0.001s)

        if (timer >= watchdog_time) {
            // 20 seconds have passed. Did it rise by at least 2 degrees?
            if (current_temp < (saved_temp + 2.0)) {
                fault_watchdog = 1;
                safe_pwm_out = 0.0; // Cut power, something is burning or broken
            }
            // Reset the timer and save the new baseline temp for the next 20s chunk
            timer = 0.0;
            saved_temp = current_temp;
        }
    } else {
        // Not actively trying to heat up, reset the watchdog logic
        timer = 0.0;
        saved_temp = current_temp;
        fault_watchdog = 0;
    }
}